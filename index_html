    <style>
        :root {
            --neon-cyan: #00f3ff;
            --neon-pink: #ff0055;
            --neon-yellow: #fcee0a;
            --dark-bg: #0a0a12;
            --card-bg: rgba(18, 18, 32, 0.75);
            --locked-color: #2a2a3a;
        }

        body {
            background-color: var(--dark-bg);
            color: #ffffff;
            font-family: 'Share Tech Mono', 'Noto Sans TC', monospace;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 50% 20%, rgba(0, 243, 255, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(255, 0, 85, 0.08) 0%, transparent 50%),
                linear-gradient(to bottom, rgba(10, 10, 18, 0.95), rgba(10, 10, 18, 0.98));
        }

        /* Scanline Overlay */
        .scanline {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(
                to bottom,
                rgba(255,255,255,0),
                rgba(255,255,255,0) 50%,
                rgba(0, 0, 0, 0.3) 50%,
                rgba(0, 0, 0, 0.3)
            );
            background-size: 100% 4px;
            pointer-events: none;
            z-index: 50;
            opacity: 0.6;
        }

        /* Grid Background pattern */
        .bg-grid {
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        }

        .avatar-frame {
            position: relative;
            padding: 4px;
            background: linear-gradient(135deg, var(--neon-cyan), var(--neon-pink));
            clip-path: polygon(15% 0, 100% 0, 100% 85%, 85% 100%, 0 100%, 0 15%);
            animation: pulseGlow 3s infinite alternate;
        }

        .avatar-img {
            clip-path: polygon(14% 0, 100% 0, 100% 84%, 86% 100%, 0 100%, 0 14%);
            filter: grayscale(20%) contrast(110%);
            transition: all 0.3s ease;
        }

        .avatar-frame:hover .avatar-img {
            filter: grayscale(0%) contrast(120%);
            transform: scale(1.03);
        }

        @keyframes pulseGlow {
            0% { box-shadow: 0 0 15px rgba(0, 243, 255, 0.4); }
            100% { box-shadow: 0 0 25px rgba(255, 0, 85, 0.6); }
        }

        /* Title Glitch Text Effect */
        .glitch-title {
            font-family: 'Orbitron', sans-serif;
            text-shadow: 0 0 10px var(--neon-cyan), 0 0 20px rgba(0, 243, 255, 0.5);
            position: relative;
        }

        /* Unlocked Cyber Card */
        .quest-card {
            background: var(--card-bg);
            border: 1px solid rgba(0, 243, 255, 0.3);
            backdrop-filter: blur(8px);
            clip-path: polygon(0 0, 90% 0, 100% 15%, 100% 100%, 10% 100%, 0 85%);
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            position: relative;
            overflow: hidden;
        }

        .quest-card::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(0, 243, 255, 0.2), transparent);
            transition: 0.5s;
        }

        .quest-card:hover::before {
            left: 100%;
        }

        .quest-card:hover {
            transform: translateY(-5px) scale(1.02);
            border-color: var(--neon-cyan);
            box-shadow: 0 0 20px rgba(0, 243, 255, 0.4), inset 0 0 15px rgba(0, 243, 255, 0.2);
        }

        .quest-card.w2-card:hover {
            border-color: var(--neon-pink);
            box-shadow: 0 0 20px rgba(255, 0, 85, 0.4), inset 0 0 15px rgba(255, 0, 85, 0.2);
        }

        /* Locked Card */
        .locked-card {
            background: rgba(15, 15, 22, 0.6);
            border: 1px dashed rgba(255, 255, 255, 0.1);
            clip-path: polygon(0 0, 90% 0, 100% 15%, 100% 100%, 10% 100%, 0 85%);
            color: #555566;
            cursor: not-allowed;
            user-select: none;
            transition: all 0.2s ease;
        }

        .locked-card:hover {
            border-color: rgba(255, 0, 85, 0.3);
            background: rgba(25, 15, 22, 0.7);
        }

        /* HUD Lines & Accents */
        .hud-corner {
            position: absolute;
            width: 8px;
            height: 8px;
            border-color: var(--neon-cyan);
        }
        .hud-tl { top: 2px; left: 2px; border-top: 2px solid; border-left: 2px solid; }
        .hud-br { bottom: 2px; right: 2px; border-bottom: 2px solid; border-right: 2px solid; }

        /* Badge status */
        .status-badge {
            font-size: 0.65rem;
            letter-spacing: 1px;
            padding: 2px 6px;
            clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--dark-bg);
        }
        ::-webkit-scrollbar-thumb {
            background: #1f1f33;
            border: 1px solid var(--neon-cyan);
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--neon-cyan);
        }
    </style>
